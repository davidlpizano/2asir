vrrp_sync_group VG_KEA {
    group { VI_LAN VI_WAN }
}
vrrp_instance VI_LAN {
    state @@STATE_KA@@
    interface @@IF_LAN@@
    virtual_router_id 51
    priority @@PRIO_KA@@
    advert_int 1
    track_interface { @@IF_LAN@@ @@IF_WAN@@ }
    authentication { auth_type PASS; auth_pass kea1234; }
    virtual_ipaddress { @@VIP_LAN@@/24 }
}
vrrp_instance VI_WAN {
    state @@STATE_KA@@
    interface @@IF_WAN@@
    virtual_router_id 52
    priority @@PRIO_KA@@
    advert_int 1
    track_interface { @@IF_LAN@@ @@IF_WAN@@ }
    authentication { auth_type PASS; auth_pass kea1234; }
    virtual_ipaddress { @@VIP_WAN@@/16 }
}
